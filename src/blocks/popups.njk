<div id="cons" aria-hidden="true" class="popup">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close popup-close-bg">
                <svg aria-hidden="true" width="12" height="12">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup__top">
                <div class="popup__title">
                    Заявка на консультацию
                </div>
                <p>
                    Отправьте заявку и наш специалист<br>
                    свяжется с Вами в ближайшее время
                </p>
            </div>
            <form data-dev data-popup-message="#thanks" action="#" class="form">
                <div class="form__inputs">
                    <div class="form__input">
                        <div class="form__placeholder">Имя</div>
                        <input data-required autocomplete="off" type="text" name="form[]" placeholder="Имя"
                            class="input">
                    </div>
                    <div class="form__input">
                        <div class="form__placeholder">Номер телефона</div>
                        <input data-required autocomplete="off" type="text" name="form[]" placeholder="Номер телефона"
                            class="input telephone">
                    </div>
                </div>
                <div class="form__checkboxes">
                    <label class="checkbox">
                        <input data-required class="checkbox__input" type="checkbox" value="1" name="form[]">
                        <span class="checkbox__label">
                            <span class="checkbox__icon">
                                <svg aria-hidden="true" width="9" height="7">
                                    <use xlink:href="img/sprite.svg#check1"></use>
                                </svg>
                            </span>
                            <span class="checkbox__text">
                                <p>
                                    Я ознакомлен с <a href="./">Политикой обработки персональных данных</a>
                                </p>
                            </span>
                        </span>
                    </label>
                    <label class="checkbox">
                        <input data-required checked class="checkbox__input" type="checkbox" value="2" name="form[]">
                        <span class="checkbox__label">
                            <span class="checkbox__icon">
                                <svg aria-hidden="true" width="9" height="7">
                                    <use xlink:href="img/sprite.svg#check1"></use>
                                </svg>
                            </span>
                            <span class="checkbox__text">
                                <p>
                                    Я даю согласие на <a href="./">обработку персональных данных</a>
                                </p>
                            </span>
                        </span>
                    </label>
                </div>
                <button type="submit" class="btn btn-bordovy">Отправить</button>
            </form>
        </div>
    </div>
</div>
<div id="thanks" aria-hidden="true" class="popup popup-thanks">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close ">
                <svg aria-hidden="true" width="18" height="18">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup__top">
                <img loading="lazy" src="img/check1.webp" alt="">
                <div class="popup__title">
                    Ваша заявка принята!
                </div>
                <p>
                    Наш менеджер свяжется с Вами
                    в ближайшее время.
                </p>
            </div>
        </div>
    </div>
</div>

<div id="present" aria-hidden="true" class="popup popup-present">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="22" height="22">
                    <use xlink:href="img/sprite.svg#close2"></use>
                </svg>
            </div>
        </div>
    </div>
</div>

